--- a/cmake/HPX_SetupLCI.cmake
+++ b/cmake/HPX_SetupLCI.cmake
@@ -7,6 +7,52 @@
 # FIXME : in the future put it directly inside the cmake directory of the
 # corresponding plugin
 
+# Directory holding the local patches applied to the fetched LCI sources
+set(HPX_LCI_PATCH_DIR ${CMAKE_CURRENT_LIST_DIR}/patches)
+
+# Apply every patches/lci-*.patch to the fetched LCI source tree. Idempotent:
+# a patch that is already applied (e.g. when re-configuring an existing build
+# tree) is skipped.
+function(hpx_apply_lci_patches lci_source_dir)
+  find_package(Git QUIET)
+  file(GLOB lci_patches ${HPX_LCI_PATCH_DIR}/lci-*.patch)
+  foreach(patch ${lci_patches})
+    get_filename_component(patch_name ${patch} NAME)
+    if(NOT GIT_FOUND)
+      message(
+        WARNING
+          "git not found, cannot apply ${patch_name} to the fetched LCI sources"
+      )
+    else()
+      execute_process(
+        COMMAND ${GIT_EXECUTABLE} apply --check --reverse ${patch}
+        WORKING_DIRECTORY ${lci_source_dir}
+        RESULT_VARIABLE already_applied
+        OUTPUT_QUIET ERROR_QUIET
+      )
+      if(already_applied EQUAL 0)
+        hpx_info("LCI patch ${patch_name} is already applied")
+      else()
+        execute_process(
+          COMMAND ${GIT_EXECUTABLE} apply ${patch}
+          WORKING_DIRECTORY ${lci_source_dir}
+          RESULT_VARIABLE apply_result
+          ERROR_VARIABLE apply_error
+        )
+        if(apply_result EQUAL 0)
+          hpx_info("Applied LCI patch ${patch_name}")
+        else()
+          message(
+            WARNING
+              "Could not apply ${patch_name} to the fetched LCI sources "
+              "(different LCI version?): ${apply_error}"
+          )
+        endif()
+      endif()
+    endif()
+  endforeach()
+endfunction()
