+        // LCI's ibv backend connects every device to every rank with one RC
+        // queue pair (QP) per remote rank, and by default also gives every QP
+        // its own thread domain. These per-process resources are finite: with
+        // ~500 ranks the thread domains run out ("ibv_alloc_td() failed:
+        // Cannot allocate memory"), followed by "Couldn't create QP" aborts
+        // during startup. The receive queue is also shared by all peers, so
+        // its default depth leaves too few buffers per peer at high rank
+        // counts and senders exhaust the HCA's RNR retry budget. Adapt the
+        // LCI defaults to the job size. Anything the user set explicitly via
+        // the LCI_ATTR_* environment variables is left untouched.
+        void tune_attr_for_scale(::lci::global_attr_t& attr, int nranks)
+        {
+            // HPX allocates its own devices and never uses LCI's internal
+            // default device, which would just build one more full QP mesh.
+            if (!lci_attr_set_by_user("LCI_ATTR_ALLOC_DEFAULT_DEVICE"))
+            {
+                attr.alloc_default_device = false;
+            }
+
+            // Above this many QPs per process, per-QP thread domains are no
+            // longer available; share the queues' locks instead.
+            constexpr int max_qps_per_process_with_td = 128;
+            if (nranks * config_t::ndevices > max_qps_per_process_with_td &&
+                !lci_attr_set_by_user("LCI_ATTR_IBV_TD_STRATEGY"))
+            {
+                attr.ibv_td_strategy = ::lci::attr_ibv_td_strategy_t::none;
+            }
