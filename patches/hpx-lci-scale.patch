@@ -0,0 +1,29 @@
+diff --git a/lct/pmi/pmi_wrapper_pmix.cpp b/lct/pmi/pmi_wrapper_pmix.cpp
+index 9bc15a78..570f0ef8 100644
+--- a/lct/pmi/pmi_wrapper_pmix.cpp
++++ b/lct/pmi/pmi_wrapper_pmix.cpp
+@@ -63,7 +63,6 @@ void publish(char* key, char* value)
+   val.type = PMIX_STRING;
+   val.data.string = value;
+   PMIX_SAFECALL(PMIx_Put(PMIX_GLOBAL, key, &val));
+-  PMIX_SAFECALL(PMIx_Commit());
+ }
+ 
+ void getname(int rank, char* key, char* value)
+@@ -80,6 +79,16 @@ void getname(int rank, char* key, char* value)
+ 
+ void barrier()
+ {
++  // PMIx_Commit() re-sends this process's *entire* local put-store on every
++  // call (a documented upstream scalability defect, not fixed until
++  // OpenPMIx's unreleased master branch -- see openpmix#4087 / #4157). The
++  // old code called it once per publish() in bootstrap::alltoall's O(N)
++  // per-rank loop, making the actual bytes shipped O(N^2) per bootstrap
++  // round -- fine at 256 ranks, a many-minutes-plus hang at 480+. Committing
++  // exactly once here, right before the fence, matches PMIx's own
++  // recommended put/commit/fence/get pattern for scalable wireup.
++  PMIX_SAFECALL(PMIx_Commit());
++
+   pmix_info_t* info;
+   PMIX_INFO_CREATE(info, 1);
+   bool flag = true;
